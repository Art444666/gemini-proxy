import httpx, json
H = {"Authorization": "Bearer rnd_8El1E5WO8lA86Rbnc32bQSE5pnuP"}
srv = "srv-dc267btg1s2s7393gd5g"
out = []
for owner in ("tea-dc267btg1s2s7393gd50",):
    r = httpx.get(
        "https://api.render.com/v1/logs",
        params={"ownerId": owner, "resource": srv, "limit": 40},
        headers=H,
        timeout=30,
    )
    out.append(str(r.status_code))
    if r.status_code == 200:
        for item in r.json().get("logs", []):
            out.append(item.get("message", ""))
open(r"D:\AI-Proj\_out.log", "w", encoding="utf-8").write("\n".join(out))
print(len(out))
